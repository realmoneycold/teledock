[Unit]
Description=TeleDock FastAPI Backend
After=network.target

[Service]
Type=simple
User=teledock
Group=teledock
WorkingDirectory=/opt/teledock/backend
Environment=PYTHONPATH=/opt/teledock/backend
EnvironmentFile=/opt/teledock/backend/.env
ExecStart=/opt/teledock/backend/venv/bin/python3 -m uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
